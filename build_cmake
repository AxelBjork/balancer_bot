#!/usr/bin/env bash
set -euo pipefail
TEST=${1:-ON}

# Configure
if [ "$TEST" = "ON" ]; then 
  BUILD_DIR=build
  CMAKE_ARGS=(
    -DBUILD_TESTS=ON
    -DCMAKE_BUILD_TYPE=Release
  )
else 
  BUILD_DIR=build-pi
  CMAKE_ARGS=(
    -DBUILD_TESTS=OFF
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_TOOLCHAIN_FILE="$(realpath cmake/toolchain-rpi4.cmake)"
  )
fi

cmake -S . -B "$BUILD_DIR" "${CMAKE_ARGS[@]}"

# Build
cmake --build "$BUILD_DIR" -j"$(nproc)"

if [ "$TEST" != "ON" ]; then
  python3 - "$BUILD_DIR/balancer_pi" pid.conf "$BUILD_DIR/balancer_pi.manifest.json" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

binary, config, manifest = map(Path, sys.argv[1:])
config_text = config.read_text(encoding="utf-8")
match = re.search(r"^\s*config_version\s*=\s*(\d+)\s*(?:#.*)?$", config_text, re.MULTILINE)
if not match:
    raise SystemExit(f"Could not read config_version from {config}")
payload = {
    "format_version": 1,
    "binary_sha256": hashlib.sha256(binary.read_bytes()).hexdigest(),
    "pid_config_sha256": hashlib.sha256(config.read_bytes()).hexdigest(),
    "pid_config_version": int(match.group(1)),
}
manifest.write_text(json.dumps(payload, sort_keys=True) + "\n", encoding="utf-8")
PY
fi

# Run tests
if [ "$TEST" = "ON" ]; then
    ctest --test-dir "$BUILD_DIR" --output-on-failure -j8
fi
