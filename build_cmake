#!/usr/bin/env bash
set -euo pipefail
TEST=${1:-ON}

# Configure
if [ "$TEST" = "ON" ]; then 
  BUILD_DIR=build
  CMAKE_ARGS=(
    -DBUILD_TESTS=ON
    -DCMAKE_BUILD_TYPE=Release
  )
else 
  BUILD_DIR=build-pi-arm
  CMAKE_ARGS=(
    -DCMAKE_TOOLCHAIN_FILE=toolchain-rpi4.cmake
    -DBUILD_TESTS=OFF
    -DCMAKE_BUILD_TYPE=Release
  )
fi

cmake -S . -B "$BUILD_DIR" "${CMAKE_ARGS[@]}"

# Build
cmake --build "$BUILD_DIR" -j"$(nproc)"

# Run tests
if [ "$TEST" = "ON" ]; then
    ctest --test-dir "$BUILD_DIR" --output-on-failure -j8
fi
