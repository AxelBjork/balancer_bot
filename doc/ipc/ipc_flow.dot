digraph IPC {
  rankdir=LR;
  bgcolor="#0F172A";
  pad=0.22;
  nodesep=0.62;
  ranksep=0.70;
  splines=spline;
  remincross=true;

  fontname="Helvetica,Arial,sans-serif";
  fontsize=52;
  fontcolor="#F1F5F9";
  label=<<B>balancer_bot IPC Flow</B>>;
  labelloc="t";

  node [fontname="Helvetica,Arial,sans-serif", shape=rect, style="filled,rounded", fixedsize=false, margin="0.12,0.08", fontsize=28, fontcolor="#FFFFFF", penwidth=4, color="#F1F5F9"];

  edge [fontname="Helvetica,Arial,sans-serif", fontsize=22, fontcolor="#CBD5E1", color="#64748B", penwidth=3.0, arrowsize=1.4, labelfloat=false, labeldistance=0.8, labelangle=10];

  subgraph cluster_sim {
    label=<<B><FONT POINT-SIZE="40">Balancer Services</FONT></B>>;
    fontcolor="#F1F5F9";
    style="rounded,filled";
    color="#475569";
    penwidth=4;
    fillcolor="#1E293B";
    margin=34;
    ImuService [
      fillcolor="#0369A1",
      label=<<B><FONT POINT-SIZE="30">ImuService</FONT></B><BR/><FONT POINT-SIZE="24">Consumes raw accelerometer/gyroscope<BR/>samples and publishes `ImuData`<BR/>samples that represent the<BR/>controller&apos;s current view of body<BR/>pitch, angular motion, and sample<BR/>time.</FONT>>
    ];
    TimeService [
      fillcolor="#0369A1",
      label=<<B><FONT POINT-SIZE="30">TimeService</FONT></B><BR/><FONT POINT-SIZE="24">Publishes the global `PhysicsTick`<BR/>heartbeat that drives deterministic<BR/>controller execution and advances the<BR/>shared simulation clock.</FONT>>
    ];
    ControlService [
      fillcolor="#0369A1",
      label=<<B><FONT POINT-SIZE="30">ControlService</FONT></B><BR/><FONT POINT-SIZE="24">Owns the balancing control pipeline<BR/>that converts `PhysicsTick`,<BR/>`ImuData`, and `JoystickCommand`, and<BR/>`MotorFeedback` inputs into<BR/>wheel-speed targets and streaming<BR/>controller telemetry.</FONT>>
    ];
    MotorService [
      fillcolor="#0369A1",
      label=<<B><FONT POINT-SIZE="30">MotorService</FONT></B><BR/><FONT POINT-SIZE="24">Implements the actuator boundary<BR/>between reflected IPC commands and the<BR/>low-level motor runner.</FONT>>
    ];
    InputService [
      fillcolor="#0369A1",
      label=<<B><FONT POINT-SIZE="30">InputService</FONT></B><BR/><FONT POINT-SIZE="24">Reads input from a hardware Xbox<BR/>controller and publishes normalized<BR/>`JoystickCommand` messages to the bus.</FONT>>
    ];
    UdpBridge [
      fillcolor="#0F766E",
      label=<<B><FONT POINT-SIZE="38">UdpBridge</FONT></B><BR/><FONT POINT-SIZE="24">Stateful transport bridge that<BR/>connects the internal `MessageBus` to<BR/>external UDP-based SIL clients.</FONT>>
    ];
  }

  subgraph cluster_sockets {
    label=<<B><FONT POINT-SIZE="40">Network Layer</FONT></B>>;
    fontcolor="#F1F5F9";
    style="rounded,filled";
    color="#F59E0B";
    penwidth=6;
    fillcolor="#2A1B07";
    margin=24;

    { rank=same; TX; RX; }

    TX [fillcolor="#B45309", label=<<B><FONT POINT-SIZE="30">TX Socket</FONT></B><BR/><FONT POINT-SIZE="24">Port 9000 (Inbound)</FONT>>];
    RX [fillcolor="#B45309", label=<<B><FONT POINT-SIZE="30">RX Socket</FONT></B><BR/><FONT POINT-SIZE="24">Client Ephemeral Port (Outbound)</FONT>>];
    TX -> RX [style=invis, weight=50, constraint=false];
  }

  subgraph cluster_pytest {
    label=<<B><FONT POINT-SIZE="40">Pytest Harness</FONT></B>>;
    fontcolor="#F1F5F9";
    style="rounded,filled";
    color="#22C55E";
    penwidth=6;
    fillcolor="#0B2A20";
    margin=24;

    TestCase [fillcolor="#047857", label=<<B><FONT POINT-SIZE="34">Test Case / Fixtures</FONT></B>>];
  }

  TestCase -> TX [label="send_msg", color="#F1F5F9", penwidth=5];
  TX -> UdpBridge [label="Inbound Traffic:\nImuRawData, JoystickCommand\nPhysicsTick", color="#F1F5F9", penwidth=5, fontsize=25];

  // Internal Service Logic
  ControlService -> MotorService [label="MotorTargets", style=dashed];
  ControlService -> UdpBridge [label="MotorTargets, SystemTelemetry", style=dashed];
  ImuService -> ControlService [label="ImuData", style=dashed];
  ImuService -> ImuService [label="ImuRawData", style=dashed];
  InputService -> ControlService [label="JoystickCommand", style=dashed];
  MotorService -> ControlService [label="MotorFeedback", style=dashed];
  TimeService -> ControlService [label="PhysicsTick", style=dashed];
  TimeService -> MotorService [label="PhysicsTick", style=dashed];
  UdpBridge -> ControlService [label="JoystickCommand, PhysicsTick", style=dashed];
  UdpBridge -> ImuService [label="ImuRawData", style=dashed];
  UdpBridge -> MotorService [label="PhysicsTick", style=dashed];

  RX -> UdpBridge [label="Outbound Traffic:\nMotorTargets, SystemTelemetry", color="#F1F5F9", penwidth=5, dir=back, fontsize=25, arrowtail=normal];
  TestCase -> RX [label="recv_msg", color="#F1F5F9", penwidth=5, dir=back, arrowtail=normal];
}
